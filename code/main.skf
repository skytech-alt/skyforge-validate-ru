// ============================================================
// skyforge-validate-ru
// Валидация российских реквизитов на нативном SkyForge.
//
// API повторяет Python/npm-версии:
//   инн_валиден, огрн_валиден, снилс_валиден, кпп_валиден,
//   бик_валиден, счёт_валиден
// ============================================================

// ---------- Вспомогательные ----------

функция только_цифры(значение) {
    пусть результат = ""
    пусть символы = строка_символы(значение)
    для с в символы {
        если цифра(с) {
            результат = результат + с
        }
    }
    вернуть результат
}

функция только_цифры_и_буквы_верхний(значение) {
    пусть результат = ""
    пусть символы = строка_символы(значение)
    для с в символы {
        если с != " " и с != "-" и с != "_" и с != "." {
            результат = результат + верхний_регистр(с)
        }
    }
    вернуть результат
}

// ---------- ИНН ----------

функция инн_валиден(значение) {
    пусть ц = только_цифры(значение)
    если длина(ц) == 10 {
        вернуть инн_10_валиден(ц)
    }
    если длина(ц) == 12 {
        вернуть инн_12_валиден(ц)
    }
    вернуть ложь
}

функция инн_10_валиден(ц) {
    пусть веса = [2, 4, 10, 3, 5, 9, 4, 6, 8]
    пусть сумма = 0
    для i от 0 до 8 {
        сумма = сумма + число(ц[i]) * веса[i]
    }
    пусть контрольная = (сумма % 11) % 10
    вернуть контрольная == число(ц[9])
}

функция инн_12_валиден(ц) {
    пусть веса_11 = [7, 2, 4, 10, 3, 5, 9, 4, 6, 8]
    пусть веса_12 = [3, 7, 2, 4, 10, 3, 5, 9, 4, 6, 8]

    пусть сумма_11 = 0
    для i от 0 до 9 {
        сумма_11 = сумма_11 + число(ц[i]) * веса_11[i]
    }
    пусть контрольная_11 = (сумма_11 % 11) % 10
    если контрольная_11 != число(ц[10]) {
        вернуть ложь
    }

    пусть сумма_12 = 0
    для i от 0 до 10 {
        сумма_12 = сумма_12 + число(ц[i]) * веса_12[i]
    }
    пусть контрольная_12 = (сумма_12 % 11) % 10
    вернуть контрольная_12 == число(ц[11])
}

// ---------- ОГРН / ОГРНИП ----------

функция огрн_валиден(значение) {
    пусть ц = только_цифры(значение)
    если длина(ц) == 13 {
        пусть первые_12 = подстрока(ц, 0, 12)
        пусть контрольная = (число(первые_12) % 11) % 10
        вернуть контрольная == число(ц[12])
    }
    если длина(ц) == 15 {
        пусть первые_14 = подстрока(ц, 0, 14)
        пусть контрольная = (число(первые_14) % 13) % 10
        вернуть контрольная == число(ц[14])
    }
    вернуть ложь
}

// ---------- СНИЛС ----------

функция снилс_валиден(значение) {
    пусть ц = только_цифры(значение)
    если длина(ц) != 11 {
        вернуть ложь
    }
    пусть сумма = 0
    для i от 0 до 8 {
        сумма = сумма + число(ц[i]) * (9 - i)
    }
    пусть ожидаемая = 0
    если сумма < 100 {
        ожидаемая = сумма
    } иначе если сумма == 100 или сумма == 101 {
        ожидаемая = 0
    } иначе {
        ожидаемая = сумма % 101
        если ожидаемая == 100 {
            ожидаемая = 0
        }
    }
    пусть фактическая = число(подстрока(ц, 9, 11))
    вернуть ожидаемая == фактическая
}

функция снилс_формат(значение) {
    пусть ц = только_цифры(значение)
    если длина(ц) != 11 {
        вернуть значение
    }
    вернуть подстрока(ц, 0, 3) + "-" + подстрока(ц, 3, 6) + "-" + подстрока(ц, 6, 9) + " " + подстрока(ц, 9, 11)
}

// ---------- КПП ----------

функция кпп_валиден(значение) {
    пусть к = только_цифры_и_буквы_верхний(значение)
    если длина(к) != 9 {
        вернуть ложь
    }
    для i от 0 до 3 {
        если не цифра(к[i]) {
            вернуть ложь
        }
    }
    для i от 4 до 5 {
        пусть с = к[i]
        если не цифра(с) и не (с >= "A" и с <= "Z") {
            вернуть ложь
        }
    }
    для i от 6 до 8 {
        если не цифра(к[i]) {
            вернуть ложь
        }
    }
    вернуть истина
}

// ---------- БИК ----------

функция бик_валиден(значение) {
    пусть ц = только_цифры(значение)
    если длина(ц) != 9 {
        вернуть ложь
    }
    вернуть подстрока(ц, 0, 2) == "04"
}

// ---------- Расчётный счёт (20 цифр, проверка с учётом БИК) ----------

функция счёт_валиден(значение, бик) {
    пусть ц = только_цифры(значение)
    если длина(ц) != 20 {
        вернуть ложь
    }
    если не бик_валиден(бик) {
        вернуть ложь
    }
    пусть бик_ц = только_цифры(бик)
    пусть веса = [7, 1, 3, 7, 1, 3, 7, 1, 3, 7, 1, 3, 7, 1, 3, 7, 1, 3, 7, 1]
    если бик_ц[6] == "0" или бик_ц[6] == "1" {
        веса[11] = 6
    } иначе {
        веса[11] = 7
    }
    пусть сумма = 0
    для i от 0 до 19 {
        сумма = сумма + число(ц[i]) * веса[i]
    }
    вернуть сумма % 10 == 0
}

// ---------- Проверка сразу нескольких полей ----------

функция проверить_все(данные) {
    пусть результаты = {}
    если данные.содержит("инн") {
        результаты["инн"] = инн_валиден(данные["инн"])
    }
    если данные.содержит("огрн") {
        результаты["огрн"] = огрн_валиден(данные["огрн"])
    }
    если данные.содержит("снилс") {
        результаты["снилс"] = снилс_валиден(данные["снилс"])
    }
    если данные.содержит("кпп") {
        результаты["кпп"] = кпп_валиден(данные["кпп"])
    }
    если данные.содержит("бик") {
        результаты["бик"] = бик_валиден(данные["бик"])
    }
    если данные.содержит("счёт") и данные.содержит("бик") {
        результаты["счёт"] = счёт_валиден(данные["счёт"], данные["бик"])
    }
    вернуть результаты
}

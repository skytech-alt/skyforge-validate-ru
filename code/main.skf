функция только_цифры(значение) {
    пусть результат = ""
    для с в строка_символы(значение) {
        если цифра(с) { результат = результат + с }
    }
    вернуть результат
}
функция инн_валиден(значение) {
    пусть ц = только_цифры(значение)
    если длина(ц) == 10 {
        пусть веса = [2, 4, 10, 3, 5, 9, 4, 6, 8]
        пусть сумма = 0
        для i от 0 до 8 { сумма = сумма + число(ц[i]) * веса[i] }
        вернуть (сумма % 11) % 10 == число(ц[9])
    }
    вернуть ложь
}